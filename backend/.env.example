# MySQL 8
DB_URL=jdbc:mysql://localhost:3306/logistics_controltower?serverTimezone=UTC
DB_USERNAME=logistics_app
DB_PASSWORD=replace-with-a-locally-managed-secret

# Base64-encoded random key containing at least 32 bytes. Example generation:
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=replace-with-base64-encoded-random-key
JWT_TTL=PT15M
CORS_ALLOWED_ORIGINS=http://localhost:3000
SERVER_PORT=8080

# Optional; only used when SPRING_PROFILES_ACTIVE=dev. Never set in production.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
